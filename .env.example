# Copy to .env and fill in. Never commit .env.

# Qdrant (started by docker-compose.yml). Keep this file in UTF-8, and no "$" in the key.
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CERVEAU_QDRANT_URL=http://127.0.0.1:6333
CERVEAU_QDRANT_API_KEY=
# Port of Qdrant on this machine (docker compose); change both lines if 6333 is taken
# CERVEAU_QDRANT_PORT=6333

# Ollama and the embedding model (must be pulled first: ollama pull bge-m3)
CERVEAU_OLLAMA_URL=http://127.0.0.1:11434
CERVEAU_EMBEDDER=ollama
CERVEAU_EMBED_MODEL=bge-m3
CERVEAU_VECTOR_SIZE=1024
# Seconds per embedding request (raise it on a slow CPU)
CERVEAU_OLLAMA_TIMEOUT=300

# Limits (characters). A text above MAX_TEXT_CHARS is refused, never truncated.
CERVEAU_MAX_TEXT_CHARS=3000
CERVEAU_CHUNK_MAX_CHARS=1500

# Collection names are <PREFIX>_docs, <PREFIX>_memories, <PREFIX>_meta
CERVEAU_PREFIX=cerveau

# Where the journal (source of truth for memories) is kept. Back this folder up.
CERVEAU_DATA_DIR=~/.cerveau

# Set to false to make the MCP server read-only (no "remember" tool)
CERVEAU_MCP_ALLOW_WRITE=true

# Local log file for bug reports, in <DATA_DIR>/logs (never sent anywhere); off to disable
CERVEAU_LOG=on
